# Travellow Environment Variables Template
# Copy this file to .env.local and fill in your real credentials.

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/travellow?retryWrites=true&w=majority

# Authentication Secret Key (HMAC Signing)
AUTH_SECRET=your_random_secure_auth_secret_key_here
NEXTAUTH_SECRET=your_random_secure_auth_secret_key_here

# Gemini AI API Key (For Phase 5)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (Optional Future Expansion)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeather API Key (Optional Future Expansion)
OPENWEATHER_API_KEY=your_openweather_api_key_here
